# ---- PayPal sandbox (server-side only; never commit real values) ----
# Create a sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Same client id, exposed to the browser for the PayPal JS SDK buttons.
# This value is public by design; the SECRET above must never be public.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---- Gemini (powers the AI: contract drafting + evidence verification) ----
# Free-tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Currency for new contracts. Must be one your sandbox BUSINESS account can
# accept, or PayPal rejects checkout with "seller doesn't accept your currency".
# US sandbox business accounts handle USD authorize/capture cleanly.
NEXT_PUBLIC_TRUSTPAY_CURRENCY=USD
